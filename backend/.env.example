# ForgeAI Backend Configuration Example
# Copy this file to .env and adjust variables as needed

# Razorpay Test Mode Credentials
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Admin Account Provisioning
ADMIN_PROVISION_ENABLED=true
ADMIN_EMAIL=admin@forgeai.com
ADMIN_PASSWORD=Admin@ForgeAI2026!
ADMIN_NAME=ForgeAI Administrator

# JWT Secret
JWT_SECRET=ForgeAISuperSecretKeyForJWTAuthTokenGeneration2026!

# AI Chatbot Configuration (Phase 5A)
# Supported providers: gemini (default if GEMINI_API_KEY set) or openai (if OPENAI_API_KEY set)
# AI_PROVIDER=gemini

# Google Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# OpenAI / OpenAI-compatible Configuration (Alternative)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# AI Chat Constraints
AI_MAX_MESSAGE_LENGTH=1000
AI_TIMEOUT_SECONDS=15
AI_RATE_LIMIT_PER_MINUTE=20
